{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=marketplace;Username=marketplace;Password=CHANGE_ME",
    "Redis": "localhost:6379"
  },
  "Redis": {
    "InstanceName": "marketplace:"
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "ExchangeName": "marketplace.events"
  },
  "Jwt": {
    "PrivateKeyPath": "CHANGE_ME_SET_VIA_ENVIRONMENT_JWT__PRIVATEKEYPATH",
    "PublicKeyPath": "CHANGE_ME_SET_VIA_ENVIRONMENT_JWT__PUBLICKEYPATH",
    "Issuer": "Marketplace.API",
    "Audience": "Marketplace.Clients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "PasswordHashing": {
    "Pepper": "CHANGE_ME_IN_ENVIRONMENT_MIN_32_CHARS",
    "DegreeOfParallelism": 4,
    "MemorySizeKb": 19456,
    "Iterations": 2,
    "HashLength": 32
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": "Information"
  }
}
